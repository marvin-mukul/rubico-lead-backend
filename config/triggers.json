{
  "_comment": "Trigger families for the zero-cost gate (P19). Tuned for RECALL: a false negative silently drops a real opportunity and is unrecoverable; a false positive costs one classify call (~$0.0002). Patterns are case-insensitive JavaScript regex sources.",
  "families": [
    {
      "key": "ai-prototype",
      "label": "AI-generated code needing production hardening",
      "archetypes": [
        "ai_code_to_production"
      ],
      "patterns": [
        "\\bvibe[- ]?cod",
        "built (?:it )?(?:with|in|using) (?:lovable|replit|bolt|cursor|v0|claude|chatgpt|copilot)",
        "\\bai[- ]generated code\\b",
        "\\bai[- ]built\\b",
        "\\bllm[- ]generated\\b",
        "\\bprototype to production\\b",
        "\\bproduction[- ]read(?:y|iness)\\b",
        "\\bmvp\\b.{0,40}\\b(?:scale|production|secure|harden)",
        "\\bno[- ]code\\b",
        "\\blow[- ]code\\b"
      ]
    },
    {
      "key": "web-build",
      "label": "Website or web application",
      "archetypes": [
        "idea_to_product",
        "fix_slowing_software"
      ],
