# Rubico Lead Engine API — environment (requirement.md §10)
# Boot fails fast if anything here is missing or malformed.

# ── Runtime ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/lead_engine"
NODE_ENV=development
PORT=3000
# FR-B15: loopback in production when Next and n8n are co-hosted.
BIND_ADDRESS=127.0.0.1

# ── Auth (§8.1, §8.3) ──────────────────────────────────────────────────────
# Both must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=
SESSION_SECRET=
DASHBOARD_EMAIL=
# argon2 hash of the dashboard password (single shared credential in Phase 0).
DASHBOARD_PASSWORD_HASH=

# ── Outbound to n8n (§8.2) ─────────────────────────────────────────────────
N8N_ALERT_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# ── LLM selection (FR-B20 — config, never code) ────────────────────────────
LLM_CLASSIFY_PROVIDER=gemini
LLM_CLASSIFY_MODEL=gemini-2.5-flash-lite
LLM_BRIEF_PROVIDER=anthropic
LLM_BRIEF_MODEL=claude-sonnet-5
# FR-AI3: briefs use the batch endpoint (50% off).
LLM_BRIEF_BATCH=true

# ── Provider credentials ───────────────────────────────────────────────────
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
PRODUCT_HUNT_TOKEN=

# ── Cost caps (§6) ─────────────────────────────────────────────────────────
MONTHLY_CAP_USD=25
DAILY_CAP_USD=1.5
PER_LEAD_BUDGET_USD=0.10
# FR-C2 is a hard cap per provider. Optional — defaults to MONTHLY_CAP_USD.
# §6.3's acceptance test sets GEMINI_MONTHLY_CAP_USD=0.01.
# GEMINI_MONTHLY_CAP_USD=
# ANTHROPIC_MONTHLY_CAP_USD=

# FR-C9: rates live in config, not code.
PRICE_TABLE_PATH=./config/pricing.json
# §2.3 — structure in JSON, numeric weights in scoring_config.
CAPABILITY_MAP_PATH=./config/capability-map.json
ARCHETYPE_PATH=./config/archetypes.json
TRIGGER_PATH=./config/triggers.json
EVIDENCE_PATH=./config/evidence.json

# ── Sources ────────────────────────────────────────────────────────────────
# FR-B21: mandatory, must contain a contact address. SEC blocks requests without it.
# Which name->domain resolver ingest.sec-edgar uses: none | clearbit.
# SEC publishes no website for Form D filers, so `none` means SEC signals are
# counted as filtered out rather than attached to a guessed company.
SEC_DOMAIN_RESOLVER=none
HACKERNEWS_QUERIES="legacy system,technical debt,migrating off,rewrite our,replatform,magento,rfp,request for proposal,looking for an agency,vibe coded,ai generated code,built with replit,built with lovable,ship to production,shopify migration,stuck in prototype"

SEC_USER_AGENT="Rubico Lead Engine (mukul@rubico.tech)"
